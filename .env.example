# ZIA .env.example — copy to .env and fill values. DO NOT store secrets in source control.

# ─── Anthropic / Claude API ───────────────────────────────────────────────────
# Company LiteLLM proxy — run these on the HOST before `docker compose up`:
#   aws sso login --profile di-admin
#   kubectl port-forward svc/litellm-proxy 4000:4000 -n aiapp
#
# Containers reach the proxy via host.docker.internal:4000.
ANTHROPIC_BASE_URL=http://host.docker.internal:4000
ANTHROPIC_API_KEY=dummy   # LiteLLM handles auth; value here is ignored by the proxy.

# Set to false to use real Claude via LiteLLM proxy.
# Set to true for offline / CI runs (mock agent still calls real MCP tools).
ZIA_USE_MOCK_AGENT=false

# ─── Webhook secret ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ─── Kafka / Redpanda ─────────────────────────────────────────────────────────
REDPANDA_BROKERS=redpanda:9092
KAFKA_TOPIC_ALERTS=zeroday.alerts.v1
KAFKA_TOPIC_DLQ=zeroday.alerts.dlq

# ─── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_DB=zia
CLICKHOUSE_DATABASE=zia
CLICKHOUSE_USER=zia
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# ─── Neo4j ────────────────────────────────────────────────────────────────────
# NEO4J_AUTH format: user/password
NEO4J_AUTH=neo4j/CHANGE_ME_NEO4J_PASSWORD
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# ─── Agent worker ─────────────────────────────────────────────────────────────
WORKER_GROUP_ID=zia-agent-worker-v1
VULN_MCP_SCRIPT=/app/mcp-tools/vuln-intel-mcp.py
EXPLOIT_MCP_SCRIPT=/app/mcp-tools/exploit-intel-mcp.py
ASSET_INVENTORY_PATH=/app/asset_inventory.json

# ─── External intelligence API keys (all optional, all free) ─────────────────
GITHUB_TOKEN=        # 5000 req/hr vs 60 unauthenticated — strongly recommended
VT_API_KEY=          # VirusTotal — 500 req/day free
ABUSEIPDB_API_KEY=   # AbuseIPDB — 1000 req/day free
SHODAN_API_KEY=      # Shodan — free key, small quota

# ─── Host-side tool URLs (used by verify_infra.py and test scripts) ───────────
ZIA_API_BASE_URL=http://localhost:8000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDPANDA_ADMIN_URL=http://localhost:9644

# Override for running tests directly on host (not in Docker):
CLICKHOUSE_HOST=localhost
REDPANDA_BROKERS=localhost:19092
NEO4J_URI=bolt://localhost:7687
